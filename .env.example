# AI Transaction Monitor - Environment Configuration
# Copy this file to .env and configure for your local environment

# PostgreSQL Primary Database Connection
# Format: postgresql+psycopg://username:password@localhost:5432/transaction_monitor
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/transaction_monitor

# Development Fallback (uncomment to use local SQLite)
# DATABASE_URL=sqlite:///data/transactions.db

# JWT Authentication Secrets
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Configuration
HUMAN_VERIFICATION_LIMIT=500000.0
CURRENCY=USD
POLICY_VERSION=2.0.0
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
